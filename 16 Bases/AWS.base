filters:
  and:
    - 'file.inFolder("10 AWS")'
properties:
  note.order:
    displayName: "#"
  file.name:
    displayName: Topic
  note.module:
    displayName: Module
  note.status:
    displayName: Status
  note.difficulty:
    displayName: Difficulty
  note.priority:
    displayName: Priority
  note.revision:
    displayName: Revision
  note.interview:
    displayName: Interview
  note.tags:
    displayName: Tags
views:
  - type: table
    name: AWS - Learning Path
    groupBy:
      property: note.module
      direction: ASC
    order:
      - note.order
      - file.name
      - note.status
      - note.difficulty
      - note.priority
      - note.interview
      - note.revision
      - note.tags
    sort:
      - property: note.order
        direction: ASC
      - property: file.name
        direction: ASC