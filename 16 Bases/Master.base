properties:
  note.order:
    displayName: "#"
  file.name:
    displayName: Note
  note.module:
    displayName: Module
  note.status:
    displayName: Status
  note.difficulty:
    displayName: Difficulty
  note.priority:
    displayName: Priority
  note.interview:
    displayName: Interview
  note.revision:
    displayName: Revision
  note.domain:
    displayName: Domain
views:
  - type: table
    name: All Topics by Domain
    order:
      - note.domain
      - note.order
      - file.name
      - note.status
      - note.difficulty
      - note.interview
    sort:
      - property: note.domain
        direction: ASC
      - property: note.order
        direction: ASC