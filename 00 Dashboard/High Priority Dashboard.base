filters:
  and:
    - note.priority == "High"
properties:
  note.order:
    displayName: "#"
  file.name:
    displayName: Note
  note.module:
    displayName: Module
  note.status:
    displayName: Status
  note.difficulty:
    displayName: Difficulty
  note.priority:
    displayName: Priority
  note.interview:
    displayName: Interview
  note.revision:
    displayName: Revision
  note.domain:
    displayName: Domain
views:
  - type: table
    name: High Priority
    order:
      - domain
      - order
      - file.name
      - status
      - interview
    sort:
      - property: order
        direction: ASC
