filters:
  and:
    - note.interview >= 4
properties:
  note.order:
    displayName: "#"
  file.name:
    displayName: Note
  note.module:
    displayName: Module
  note.status:
    displayName: Status
  note.difficulty:
    displayName: Difficulty
  note.priority:
    displayName: Priority
  note.interview:
    displayName: Interview
  note.revision:
    displayName: Revision
  note.domain:
    displayName: Domain
views:
  - type: table
    name: High-Value Interview Topics
    order:
      - domain
      - file.name
      - interview
      - difficulty
      - status
    sort:
      - property: interview
        direction: DESC
      - property: domain
        direction: ASC
