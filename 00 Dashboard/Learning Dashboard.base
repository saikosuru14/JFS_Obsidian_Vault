filters:
  and:
    - 'note.status == "Learning"'
properties:
  note.order:
    displayName: "#"
  file.name:
    displayName: Note
  note.module:
    displayName: Module
  note.status:
    displayName: Status
  note.difficulty:
    displayName: Difficulty
  note.priority:
    displayName: Priority
  note.interview:
    displayName: Interview
  note.revision:
    displayName: Revision
  note.domain:
    displayName: Domain
views:
  - type: table
    name: Currently Learning
    order:
      - note.domain
      - file.name
      - note.status
      - note.difficulty
      - note.interview
    sort:
      - property: note.domain
        direction: ASC